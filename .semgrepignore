# Opengrep / Semgrep: paths that never ship in the application.
# A .semgrepignore replaces the tool's built-in list, so that list is repeated here.
:include .gitignore
node_modules/
build/
dist/
vendor/
.env/
.venv/
.tox/
*.min.js
.npm/
.yarn/
test/
tests/
*_test.go
.semgrep
.semgrep_logs/

