include_guard(GLOBAL)
find_package(Qt6 6.8 REQUIRED COMPONENTS Core Gui Network)
add_library(veyra_psn_service STATIC
    "${VEYRA_ROOT}/src/ui/PsnService.cpp"
    "${VEYRA_ROOT}/include/veyra/ui/PsnService.h")
set_target_properties(veyra_psn_service PROPERTIES AUTOMOC ON)
target_compile_features(veyra_psn_service PUBLIC cxx_std_20)
target_compile_definitions(veyra_psn_service PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
if(MSVC)
    target_compile_options(veyra_psn_service PRIVATE /utf-8)
endif()
target_link_libraries(veyra_psn_service PUBLIC veyra_remoteplay_chiaki Qt6::Core Qt6::Gui Qt6::Network PRIVATE crypt32)
add_executable(veyra_psn_tests "${VEYRA_ROOT}/tests/remoteplay/PsnServiceTests.cpp")
target_compile_features(veyra_psn_tests PRIVATE cxx_std_20)
if(MSVC)
    target_compile_options(veyra_psn_tests PRIVATE /utf-8)
endif()
target_link_libraries(veyra_psn_tests PRIVATE veyra_psn_service)
add_test(NAME remoteplay-psn-auth COMMAND veyra_psn_tests)
set_tests_properties(remoteplay-psn-auth PROPERTIES TIMEOUT 60)
