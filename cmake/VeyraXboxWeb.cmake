include_guard(GLOBAL)
# Xbox v2 transport: the reference Chromium player (xstreaming-player fork, MIT)
# inside WebView2. WebView2Host owns the STA thread, the invisible controller
# and the encoded-frame relay; XboxWebSource.cpp is added to veyra_sources by
# the main CMakeLists (it needs CaptureCompressedDecoder from there).
#
#   veyra_xbox_web   WebView2Host + the embedded player bundle resource object.
#
# WebView2 SDK comes from the vcpkg tree on CMAKE_PREFIX_PATH
# (deps/xbox-installed/x64-windows-static): WebView2LoaderStatic.lib means no
# loader DLL ships; the Evergreen runtime is installed on the user's machine.
find_package(unofficial-webview2 CONFIG REQUIRED)

# The player bundle is embedded twice on purpose: the UI target registers it
# as a Qt resource (:/xbox-player/..., see the qt_add_resources block), and
# this library compiles the same payload into a plain byte array so the host
# works in any consumer (tests, tools) without linking Qt. The host reads the
# bytes directly; no Qt resource machinery is involved on this side.
set(VEYRA_XBOX_PLAYER_BUNDLE "${VEYRA_ROOT}/resources/xbox-player/veyra-xbox-player.js")
if(NOT EXISTS "${VEYRA_XBOX_PLAYER_BUNDLE}")
  message(FATAL_ERROR "Xbox v2 player bundle missing: ${VEYRA_XBOX_PLAYER_BUNDLE} (build xstreaming-player and stage dist/assets/veyra-xbox-player.js)")
endif()
set(VEYRA_XBOX_PLAYER_EMBED_CPP "${CMAKE_CURRENT_BINARY_DIR}/veyra_xbox_player_js_data.cpp")
add_custom_command(OUTPUT "${VEYRA_XBOX_PLAYER_EMBED_CPP}"
  COMMAND "${CMAKE_COMMAND}"
          "-DBUNDLE=${VEYRA_XBOX_PLAYER_BUNDLE}"
          "-DOUT_FILE=${VEYRA_XBOX_PLAYER_EMBED_CPP}"
          -P "${CMAKE_CURRENT_LIST_DIR}/VeyraXboxWebEmbed.cmake"
  DEPENDS "${VEYRA_XBOX_PLAYER_BUNDLE}" "${CMAKE_CURRENT_LIST_DIR}/VeyraXboxWebEmbed.cmake" VERBATIM)

add_library(veyra_xbox_web STATIC
  "${VEYRA_ROOT}/src/xbox/WebView2Host.cpp"
  "${VEYRA_XBOX_PLAYER_EMBED_CPP}")
target_compile_features(veyra_xbox_web PUBLIC cxx_std_20)
set_target_properties(veyra_xbox_web PROPERTIES CXX_EXTENSIONS OFF)
target_compile_definitions(veyra_xbox_web PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN UNICODE _UNICODE)
target_include_directories(veyra_xbox_web PUBLIC "${VEYRA_ROOT}/include")
target_link_libraries(veyra_xbox_web
  PUBLIC veyra_xbox_protocol unofficial::webview2::webview2
  PRIVATE ole32 oleaut32 user32 advapi32 version)
veyra_apply_warnings(veyra_xbox_web)
# The generated byte array is data, not Veyra-owned code.
set_source_files_properties("${VEYRA_XBOX_PLAYER_EMBED_CPP}" PROPERTIES COMPILE_OPTIONS "/WX-")