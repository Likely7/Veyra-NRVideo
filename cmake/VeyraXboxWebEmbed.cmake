# Script mode: embeds the Xbox v2 player bundle as a plain C array.
# Inputs: BUNDLE (the .js file), OUT_FILE (the .cpp to generate).
# The host reads the bytes directly; no Qt resource machinery is involved.
file(READ "${BUNDLE}" hex HEX)
string(LENGTH "${hex}" hexlen)
math(EXPR bytecount "${hexlen} / 2")
set(body "")
set(at 0)
while(at LESS hexlen)
  string(SUBSTRING "${hex}" ${at} 8192 chunk)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," chunk "${chunk}")
  string(APPEND body "${chunk}\n")
  math(EXPR at "${at} + 8192")
endwhile()
file(WRITE "${OUT_FILE}"
"// Generated by VeyraXboxWebEmbed.cmake from resources/xbox-player/veyra-xbox-player.js. Do not edit.\n"
"extern \"C\" const unsigned char veyra_xbox_player_js[] = {\n${body}};\n"
"extern \"C\" const unsigned long long veyra_xbox_player_js_size = ${bytecount}ull;\n")