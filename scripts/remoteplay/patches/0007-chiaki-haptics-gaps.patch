 				CHIAKI_LOGE(audio_receiver->log, "Failed to unlock audio receiver mutex: %s", chiaki_error_string(err));
 				return;
 			}
-			if(frame_cb)
+			if(deliver_buf && audio_receiver->session->veyra_haptics_frame_cb)
+				audio_receiver->session->veyra_haptics_frame_cb(deliver_buf, deliver_buf_size, gap_before, frame_cb_user);
+			else if(frame_cb)
 				frame_cb(deliver_buf, deliver_buf_size, frame_cb_user);
 			return;
 		}
