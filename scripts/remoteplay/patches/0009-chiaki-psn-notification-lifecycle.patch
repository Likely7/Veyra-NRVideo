+static void psn_diagnostic(Session *session, unsigned event, unsigned http_status)
+{
+    chiaki_mutex_lock(&session->state_mutex);
+    const unsigned state = (unsigned)session->state;
+    chiaki_mutex_unlock(&session->state_mutex);
+    CHIAKI_LOGI(session->log, "VEYRA_PSN_DIAG event=%u state=%u http=%u",
+        event, state, http_status >= 100 && http_status <= 599 ? http_status : 0u);
+}
+
+static void psn_http_accepted(Session *session, CURL *curl, unsigned event)
+{
+    long status = 0;
+    curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status);
+    psn_diagnostic(session, event, status >= 100 && status <= 599 ? (unsigned)status : 0u);
+}
+
+// Compute the terminal decision before publishing: the waiter owns and may free
+// notif immediately after notif_mutex is released. Match the upstream fix from
+// 1625cd640146fd25f2cce65eea3a33df79748757 without logging session identifiers.
+static bool publish_notification(Session *session, Notification *notif)
+{
+    bool session_deleted = false;
+    if(notif->type == NOTIFICATION_TYPE_SESSION_DELETED)
+    {
+        json_object *sid_json = NULL;
+        json_pointer_get(notif->json, "/body/data/sessionId", &sid_json);
+        const char *deleted_id = sid_json && json_object_is_type(sid_json, json_type_string)
+            ? json_object_get_string(sid_json) : NULL;
+        chiaki_mutex_lock(&session->state_mutex);
+        session_deleted = !deleted_id || !session->session_id[0]
+            || strcmp(deleted_id, session->session_id) == 0;
+        chiaki_mutex_unlock(&session->state_mutex);
+        psn_diagnostic(session, session_deleted ? 7 : 8, 0);
+    }
+    chiaki_mutex_lock(&session->notif_mutex);
+    enqueueNq(session->ws_notification_queue, notif);
+    chiaki_cond_signal(&session->notif_cond);
+    chiaki_mutex_unlock(&session->notif_mutex);
+    return session_deleted;
+}
+
+static void websocket_finished(Session *session)
+{
+    chiaki_mutex_lock(&session->state_mutex);
+    session->ws_open = false;
+    session->ws_thread_finished = true;
+    CHIAKI_LOGI(session->log, "VEYRA_PSN_DIAG event=%u state=%u http=%u", 10u, (unsigned)session->state, 0u);
+    chiaki_cond_signal(&session->state_cond);
+    chiaki_mutex_unlock(&session->state_mutex);
+    // Never nest state_mutex and notif_mutex. The waiter only needs its own
+    // condition predicate; a close before waiting must not lose the wakeup.
+    chiaki_mutex_lock(&session->notif_mutex);
+    session->ws_notifications_finished = true;
+    chiaki_cond_signal(&session->notif_cond);
+    chiaki_mutex_unlock(&session->notif_mutex);
+}
