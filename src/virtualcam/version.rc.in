#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VCAM_VERSION_MAJOR@,@VCAM_VERSION_MINOR@,@VCAM_VERSION_PATCH@,0
 PRODUCTVERSION @VCAM_VERSION_MAJOR@,@VCAM_VERSION_MINOR@,@VCAM_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @VCAM_FILETYPE@
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "Veyra"
   VALUE "FileDescription", "@VCAM_FILE_DESCRIPTION@"
   VALUE "FileVersion", "@VCAM_DISPLAY_VERSION@"
   VALUE "InternalName", "@VCAM_INTERNAL_NAME@"
   VALUE "ProductName", "Veyra"
   VALUE "ProductVersion", "@VCAM_DISPLAY_VERSION@"
   VALUE "OriginalFilename", "@VCAM_ORIGINAL_FILENAME@"
   VALUE "LegalCopyright", "Veyra contributors. GPL-3.0."
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
