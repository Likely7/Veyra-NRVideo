{
  "manifest_version": 3,
  "name": "在 Veyra 播放",
  "version": "1.1",
  "description": "把当前标签页的直接媒体地址交给 Veyra 播放",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:18765/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "在 Veyra 播放",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
